digraph G { graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", label="Component assessment and fallback", labelloc=t, fontname="Helvetica", fontsize=18]; node [shape=box, style="rounded,filled", fillcolor="#EFF5FA", color="#46647B", fontname="Helvetica", fontsize=11, margin="0.15,0.10"]; edge [color="#46647B", fontname="Helvetica", fontsize=10]; a [label="Claim"]; b [label="Qwen decomposition\n1 to 8 unique nonempty components"]; c [label="Valid count?",shape=diamond]; fail [label="Recorded failure"]; d [label="Number and omission checks\nthen model split review"]; e [label="Split accepted?",shape=diamond]; fallback [label="Whole claim Qwen fallback\nno localized judgments"]; source [label="Saved source text"]; retrieve [label="Per component passage retrieval\n160 word windows; stride 120; top 4"]; judge [label="Qwen component judgment\nsupported, unsupported, contradicted"]; agg [label="Aggregate supported components\nall: complete; some: partial; none: no support"]; a -> b -> c; c -> fail [label="no"]; c -> d [label="yes"]; d -> e; e -> fallback [label="no"]; e -> retrieve [label="yes"]; source -> retrieve; source -> fallback; retrieve -> judge -> agg; }