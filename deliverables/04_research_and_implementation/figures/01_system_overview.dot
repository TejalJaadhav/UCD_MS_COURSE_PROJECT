digraph G { graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", label="Overall system architecture", labelloc=t, fontname="Helvetica", fontsize=18]; node [shape=box, style="rounded,filled", fillcolor="#EFF5FA", color="#46647B", fontname="Helvetica", fontsize=11, margin="0.15,0.10"]; edge [color="#46647B", fontname="Helvetica", fontsize=10]; input [label="Claim and saved source"]; route [label="Evaluation method"]; nli [label="NLI cross encoder\nplus fitted score mapping"]; whole [label="Whole claim Qwen\nplus ranked passages"]; comp [label="Component pipeline\nwith checks and fallback"]; out [label="Overall support label"]; detail [label="Component labels and passages\nwhen decomposition is accepted"]; analysis [label="Saved reports\nclassification and localization analysis"]; input -> route; route -> {nli whole comp}; {nli whole comp} -> out; comp -> detail; {out detail} -> analysis; }