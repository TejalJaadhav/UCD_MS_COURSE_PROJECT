digraph G { graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", label="NLI model and project fitted mapping", labelloc=t, fontname="Helvetica", fontsize=18]; node [shape=box, style="rounded,filled", fillcolor="#EFF5FA", color="#46647B", fontname="Helvetica", fontsize=11, margin="0.15,0.10"]; edge [color="#46647B", fontname="Helvetica", fontsize=10]; a [label="Source premise and claim hypothesis"]; b [label="Pair tokenization\n512 tokens; truncate source only"]; c [label="Pretrained DeBERTa NLI cross encoder\n6 encoder layers; hidden 768; 12 heads\nfixed during project fitting"]; d [label="NLI logits then softmax\ncontradiction, entailment, neutral"]; e [label="Project fitted Linear 3 to 3\n12 parameters"]; f [label="Softmax then argmax\ncomplete, partial, no support"]; train [label="90 training pairs\n30 per label; seed 42"]; a -> b -> c -> d -> e -> f; train -> e [style=dashed,label="fit mapping only"]; }