digraph G { graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", label="Experimental evidence selection and verification", labelloc=t, fontname="Helvetica", fontsize=18]; node [shape=box, style="rounded,filled", fillcolor="#EFF5FA", color="#46647B", fontname="Helvetica", fontsize=11, margin="0.15,0.10"]; edge [color="#46647B", fontname="Helvetica", fontsize=10]; a [label="Original component result\nretain previous labels and prediction"]; b [label="Component output available?",shape=diamond]; bypass [label="Return original result\nfallback or decomposition failure"]; c [label="Split retrieved passages into sentences\nassign deduplicated sentence IDs"]; d [label="Qwen rejudgment and evidence ID\nunsupported uses ID 0"]; e [label="Valid ID and label?",shape=diamond]; fail [label="Invalid component\noverall failure"]; f [label="Selected label unsupported?",shape=diamond]; g [label="Extra Qwen check on selected sentence\nreturn label and reason"]; h [label="Keep unsupported label"]; i [label="Aggregate revised labels\nany invalid component means failure"]; a -> b; b -> bypass [label="no"]; b -> c [label="yes"]; c -> d -> e; e -> fail [label="no"]; e -> f [label="yes"]; f -> h [label="yes"]; f -> g [label="no"]; {g h} -> i; }